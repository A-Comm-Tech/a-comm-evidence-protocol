{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.a-comm.ai/schema/merkle-commitment-profile.json",
  "title": "AEP Merkle commitment profile (D126, I38)",
  "description": "The call_commitment slot (§3.9.4), the call record, a commitmentDisclosures entry (§6.1) and a commitment_checks entry (§5). Other protocol_metadata members follow §3.9.4 and are not constrained here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "chain_id": { "type": "string", "format": "uuid" },
    "protocol_metadata": { "$ref": "#/$defs/protocolMetadata" },
    "commitmentDisclosures": {
      "type": "array",
      "items": { "$ref": "#/$defs/disclosure" }
    },
    "commitment_checks": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/commitmentCheck" } },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "atomic": {
      "description": "Non-negative integer in base units, as a string (§3.9.10 amount_atomic).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "timestamp": {
      "description": "RFC 3339 UTC, whole seconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "kind": { "enum": ["call", "line_item"] },
    "protocolMetadata": {
      "description": "§3.9.4 protocol_metadata, members this profile constrains.",
      "type": "object",
      "properties": {
        "call_commitment": {
          "oneOf": [{ "$ref": "#/$defs/callCommitment" }, { "type": "null" }]
        },
        "tool_invocation": {},
        "http_payment": {}
      },
      "if": {
        "required": ["call_commitment"],
        "properties": { "call_commitment": { "type": "object" } }
      },
      "then": {
        "required": ["tool_invocation", "http_payment"],
        "properties": {
          "tool_invocation": { "type": "null" },
          "http_payment": { "type": "null" }
        }
      }
    },
    "callCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_alg", "root", "leaf_count", "network", "asset", "amount_total_atomic"],
      "properties": {
        "tree_alg": { "const": "rfc9162-sha256" },
        "root": { "$ref": "#/$defs/sha256" },
        "leaf_count": { "type": "integer", "minimum": 1 },
        "network": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "amount_total_atomic": { "$ref": "#/$defs/atomic" }
      }
    },
    "callRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_at", "amount_atomic", "tool_invocation", "http_payment"],
      "properties": {
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "amount_atomic": { "$ref": "#/$defs/atomic" },
        "tool_invocation": {
          "description": "§3.9.9 object, or null when the paid call is not an MCP tool call.",
          "type": ["object", "null"]
        },
        "http_payment": {
          "description": "§3.9.10 object.",
          "type": "object",
          "required": ["scheme", "network", "asset"]
        }
      }
    },
    "lineItemRecord": {
      "description": "One §3.5 items entry, as the cart lists it. Its fields are governed by §3.5 and I38.",
      "type": "object"
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index", "record", "inclusion_path"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "index": { "type": "integer", "minimum": 0 },
        "record": { "type": "object" },
        "inclusion_path": {
          "description": "RFC 9162 §2.1.3 inclusion path, leaf to root.",
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "call" } } },
          "then": { "properties": { "record": { "$ref": "#/$defs/callRecord" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "line_item" } } },
          "then": { "properties": { "record": { "$ref": "#/$defs/lineItemRecord" } } }
        }
      ]
    },
    "commitmentCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "leaf_count", "leaves_disclosed", "leaves_verified", "amount_sum_checked", "amount_sum_matches"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "leaf_count": { "type": "integer", "minimum": 1 },
        "leaves_disclosed": { "type": "integer", "minimum": 0 },
        "leaves_verified": { "type": "integer", "minimum": 0 },
        "amount_sum_checked": { "type": ["boolean", "null"] },
        "amount_sum_matches": { "type": ["boolean", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "call" } } },
          "then": { "properties": { "amount_sum_checked": { "type": "boolean" } } },
          "else": { "properties": { "amount_sum_checked": { "type": "null" } } }
        },
        {
          "if": { "properties": { "amount_sum_checked": { "const": true } } },
          "then": { "properties": { "amount_sum_matches": { "type": "boolean" } } },
          "else": { "properties": { "amount_sum_matches": { "type": "null" } } }
        }
      ]
    }
  }
}
